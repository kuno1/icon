{
    "name": "kunoichi/icon",
    "description": "A icon toolset for WordPress",
    "type": "library",
    "license": "GPL-3.0-or-later",
    "authors": [
        {
            "name": "fumikito",
            "email": "guy@hametuha.com"
        }
    ],
    "scripts": {
        "test": "phpunit",
        "lint": "phpcs --standard=phpcs.ruleset.xml ./src ./icon.php",
        "fix": "phpcbf --standard=phpcs.ruleset.xml ./src ./icon.php"
    },
    "minimum-stability": "stable",
    "config": {
        "platform": {
            "php": "7.4"
        },
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "require": {
        "php": ">=7.4",
        "hametuha/singleton-pattern": "^1.2"
    },
    "require-dev": {
        "phpunit/phpunit": ">=5.7",
        "yoast/phpunit-polyfills": "^1.0",
        "squizlabs/php_codesniffer": "^3.9",
        "wp-coding-standards/wpcs": "^3.0"
    },
    "autoload": {
        "psr-0": {
            "Kunoichi\\Icon": "src"
        }
    }
}
